# ---------- Étape 1 : compilation des assets (Tailwind / Vite) ----------
FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---------- Étape 2 : application Laravel avec FrankenPHP ----------
FROM dunglas/frankenphp:1-php8.5

# 1. Extensions PHP requises par Laravel (pdo_sqlite est déjà incluse dans l'image)
RUN install-php-extensions pcntl pdo_mysql gd zip intl redis bcmath soap

# 2. Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /app

# 3. Dépendances d'abord (optimise le cache Docker)
COPY composer.json composer.lock /app/

# 4. Dépendances de production, sans scripts ni autoloader
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

# 5. Reste de l'application
COPY . /app

# 6. Assets compilés à l'étape 1 (crée public/build/manifest.json)
COPY --from=assets /app/public/build /app/public/build

# 7. Autoloader final optimisé
RUN composer dump-autoload --optimize --no-dev

# 8. Permissions indispensables pour Laravel
RUN chown -R www-data:www-data /app/storage /app/bootstrap/cache /app/database

EXPOSE 80

CMD ["frankenphp", "php-server", "--listen", ":80", "--root", "public/"]