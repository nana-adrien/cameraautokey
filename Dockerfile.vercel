# ---------- Application Laravel avec FrankenPHP (déploiement conteneur Vercel) ----------
# Le site n'utilise ni Vite ni Tailwind compilé : CSS et JS sont déjà dans public/.
FROM dunglas/frankenphp:1-php8.5

# 1. Extensions PHP (pdo_sqlite est déjà incluse ; pdo_pgsql pour une base PostgreSQL persistante)
RUN install-php-extensions pcntl pdo_mysql pdo_pgsql gd zip intl redis bcmath soap opcache

# 2. Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# 3. Dépendances d'abord (optimise le cache Docker)
COPY composer.json composer.lock /app/

# 4. Dépendances de production, sans scripts ni autoloader
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

# 5. Reste de l'application (.dockerignore exclut .env, vendor, bases locales…)
COPY . /app

# 6. Autoloader final optimisé (+ découverte des paquets Laravel)
RUN composer dump-autoload --optimize --no-dev

# 7. Valeurs par défaut de la version de TEST — toute variable définie dans Vercel les remplace.
#    Secrets obligatoires dans Vercel : APP_KEY et ADMIN_PASSWORD.
ENV APP_NAME="CAMER AUTO KEY" \
    APP_ENV=staging \
    APP_DEBUG=false \
    APP_LOCALE=fr \
    APP_FALLBACK_LOCALE=fr \
    APP_TIMEZONE=Africa/Douala \
    LOG_CHANNEL=stderr \
    SESSION_DRIVER=cookie \
    SESSION_SECURE_COOKIE=true \
    CACHE_STORE=database \
    QUEUE_CONNECTION=sync \
    MAIL_MAILER=log \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/app/database/database.sqlite

# 8. Permissions indispensables pour Laravel + script de démarrage
RUN chmod +x /app/docker/entrypoint.sh \
    && chown -R www-data:www-data /app/storage /app/bootstrap/cache /app/database

# Vercel envoie le trafic sur le port 80 (modifiable avec la variable PORT).
EXPOSE 80

CMD ["/app/docker/entrypoint.sh"]
